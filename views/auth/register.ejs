<%- include('../partials/header', { activePage: 'register' }) %>

<div class="auth-wrapper">
  <div class="auth-box">
    
    <!-- Auth Mode Switcher Tabs (Masuk vs Daftar) -->
    <div class="auth-tabs">
      <a href="/login<%= redirect ? '?redirect=' + encodeURIComponent(redirect) : '' %>" class="auth-tab">
        <i class="bi bi-box-arrow-in-right"></i> Masuk (Login)
      </a>
      <a href="/daftar<%= redirect ? '?redirect=' + encodeURIComponent(redirect) : '' %>" class="auth-tab active">
        <i class="bi bi-person-plus-fill"></i> Daftar Akun
      </a>
    </div>

    <div class="auth-header">
      <div class="app-logo-badge" style="margin: 0 auto 10px; width: 44px; height: 44px; font-size: 1.3rem;">
        <i class="bi bi-person-plus-fill"></i>
      </div>
      <h2 class="auth-title">Daftar <span class="neon-gradient-text">Akun Baru</span></h2>
      <p style="color: var(--text-secondary); font-size: 0.82rem; line-height: 1.4;">
        Daftar untuk kemudahan beli langsung, simpan alamat, dan pantau resi pesanan ponsel Anda.
      </p>
    </div>

    <% if (error) { %>
      <div class="alert alert-error" style="font-size: 0.78rem;">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/daftar" method="POST">
      <input type="hidden" name="redirect" value="<%= redirect %>">

      <div class="form-group">
        <label class="form-label">Nama Lengkap *</label>
        <input type="text" name="name" class="form-control" placeholder="Nama lengkap Anda" value="<%= form.name || '' %>" required>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
        <div class="form-group">
          <label class="form-label">No. WhatsApp *</label>
          <input type="text" name="phone" class="form-control" placeholder="08xxxxxxxxxx" value="<%= form.phone || '' %>" required>
        </div>

        <div class="form-group">
          <label class="form-label">Email (Opsional)</label>
          <input type="email" name="email" class="form-control" placeholder="nama@email.com" value="<%= form.email || '' %>">
        </div>
      </div>

      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
        <div class="form-group">
          <label class="form-label">Kata Sandi *</label>
          <input type="password" name="password" class="form-control" placeholder="Min. 6 digit" required>
        </div>

        <div class="form-group">
          <label class="form-label">Ulangi Sandi *</label>
          <input type="password" name="confirm_password" class="form-control" placeholder="Ulangi" required>
        </div>
      </div>

      <div class="form-group">
        <label class="form-label">Alamat Lengkap Pengiriman</label>
        <textarea name="address" class="form-control" rows="2" placeholder="Nama Jalan, RT/RW, Harjosari, Kab. Semarang"><%= form.address || '' %></textarea>
        <div class="form-hint">Mempermudah saat proses checkout belanja</div>
      </div>

      <div style="margin-top: 20px;">
        <button type="submit" class="btn btn-neon-primary" style="width: 100%; padding: 11px; font-size: 0.95rem;">
          <i class="bi bi-person-check-fill"></i> Buat Akun & Lanjut
        </button>
      </div>
    </form>

    <div style="text-align: center; margin-top: 20px; padding-top: 14px; border-top: 1px solid #f1f5f9; font-size: 0.82rem; color: var(--text-secondary);">
      Sudah punya akun? <a href="/login<%= redirect ? '?redirect=' + encodeURIComponent(redirect) : '' %>" style="color: #0284c7; font-weight: 800;">Masuk di Sini &rarr;</a>
    </div>
  </div>
</div>

<%- include('../partials/footer') %>
