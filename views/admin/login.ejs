<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login Administrator - Anugrah Cell Ungaran</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body style="background: #090e1a; min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 20px;">

  <div class="auth-box" style="max-width: 440px;">
    <div class="auth-header">
      <div class="logo-icon" style="margin: 0 auto 16px; width: 50px; height: 50px; font-size: 1.6rem;">
        <i class="bi bi-shield-lock-fill"></i>
      </div>
      <h2 class="auth-title">Login Panel Admin</h2>
      <p style="color: var(--text-secondary); font-size: 0.85rem;">
        Khusus Manajemen & Staf Toko <strong>Anugrah Cell Ungaran</strong>
      </p>
    </div>

    <% if (error) { %>
      <div class="alert alert-error">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/admin/login" method="POST">
      <div class="form-group">
        <label class="form-label">Email / Username Admin</label>
        <input type="text" name="identifier" class="form-control" value="admin@anugrahcell.com" required autofocus>
      </div>

      <div class="form-group">
        <label class="form-label">Kata Sandi</label>
        <input type="password" name="password" class="form-control" placeholder="Kata sandi admin" required>
        <div class="form-hint">Default: <code>admin123</code></div>
      </div>

      <div style="margin-top: 25px;">
        <button type="submit" class="btn btn-gold btn-lg" style="width: 100%;">
          <i class="bi bi-box-arrow-in-right"></i> Masuk ke Panel Admin
        </button>
      </div>
    </form>

    <div style="text-align: center; margin-top: 25px; padding-top: 20px; border-top: 1px solid var(--border-color);">
      <a href="/" style="font-size: 0.85rem; color: var(--text-muted);">
        <i class="bi bi-arrow-left"></i> Kembali ke Layar Depan Toko
      </a>
    </div>
  </div>

</body>
</html>
